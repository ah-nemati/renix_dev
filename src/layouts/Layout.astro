---
import '../styles/global.css';
import { SITE } from '../config/seo';
import type { SiteMeta } from '../config/seo';

interface Props extends SiteMeta {}

const {
  title       = `${SITE.name} — ${SITE.tagline}`,
  description = SITE.description,
  keywords    = SITE.keywords,
  ogImage     = SITE.ogImage,
  ogImageAlt  = SITE.ogImageAlt,
  canonical   = Astro.url.href,
  type        = 'website',
  noindex     = false,
  publishedAt,
  modifiedAt,
} = Astro.props;

const canonicalURL = new URL(canonical, SITE.url).href;
const robotsContent = noindex
  ? 'noindex, nofollow'
  : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';
// Explicitly typed as string to satisfy <meta content> which requires string, not string[]
const keywordsStr: string = Array.isArray(keywords)
  ? [...keywords].join(', ')
  : (keywords ?? '');

// JSON-LD: Organisation (global, appears on every page)
const orgSchema = {
  '@context':     'https://schema.org',
  '@type':        'ProfessionalService',
  '@id':          `${SITE.url}/#organisation`,
  name:           SITE.name,
  url:            SITE.url,
  logo: {
    '@type':      'ImageObject',
    url:          SITE.logo,
    contentUrl:   SITE.logo,
  },
  image:          SITE.ogImage,
  description:    SITE.description,
  email:          SITE.email,
  foundingDate:   SITE.founded,
  areaServed:     'Worldwide',
  hasMap:         SITE.url,
  sameAs: Object.values(SITE.socials),
  contactPoint: {
    '@type':       'ContactPoint',
    contactType:   'customer service',
    email:         SITE.email,
    availableLanguage: 'English',
  },
};

// JSON-LD: WebSite (with SearchAction for Sitelinks Searchbox eligibility)
const websiteSchema = {
  '@context':  'https://schema.org',
  '@type':     'WebSite',
  '@id':       `${SITE.url}/#website`,
  url:         SITE.url,
  name:        SITE.name,
  description: SITE.description,
  publisher: { '@id': `${SITE.url}/#organisation` },
  potentialAction: {
    '@type':        'SearchAction',
    target: {
      '@type':      'EntryPoint',
      urlTemplate:  `${SITE.url}/?q={search_term_string}`,
    },
    'query-input': 'required name=search_term_string',
  },
};
---

<!DOCTYPE html>
<html lang={SITE.language} dir="ltr" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />

  <!-- ═══════════════════════════════════════════
       PRIMARY META
  ═══════════════════════════════════════════ -->
  <title>{title}</title>
  <meta name="description"  content={description} />
  <meta name="keywords"     content={keywordsStr} />
  <meta name="author"       content={SITE.name} />
  <meta name="generator"    content={Astro.generator} />
  <meta name="robots"       content={robotsContent} />
  <meta name="googlebot"    content={robotsContent} />
  <link rel="canonical"     href={canonicalURL} />

  <!-- Language -->
  <link rel="alternate" hreflang="en" href={canonicalURL} />
  <link rel="alternate" hreflang="x-default" href={SITE.url} />

  <!-- ═══════════════════════════════════════════
       OPEN GRAPH  (Facebook, LinkedIn, Slack, iMessage…)
  ═══════════════════════════════════════════ -->
  <meta property="og:type"          content={type} />
  <meta property="og:url"           content={canonicalURL} />
  <meta property="og:site_name"     content={SITE.name} />
  <meta property="og:title"         content={title} />
  <meta property="og:description"   content={description} />
  <meta property="og:image"         content={ogImage} />
  <meta property="og:image:width"   content="1200" />
  <meta property="og:image:height"  content="630" />
  <meta property="og:image:type"    content="image/png" />
  <meta property="og:image:alt"     content={ogImageAlt} />
  <meta property="og:locale"        content={SITE.locale} />
  {publishedAt && <meta property="article:published_time" content={publishedAt} />}
  {modifiedAt  && <meta property="article:modified_time"  content={modifiedAt} />}

  <!-- ═══════════════════════════════════════════
       TWITTER / X CARDS
  ═══════════════════════════════════════════ -->
  <meta name="twitter:card"        content="summary_large_image" />
  <meta name="twitter:site"        content={SITE.twitter} />
  <meta name="twitter:creator"     content={SITE.twitter} />
  <meta name="twitter:title"       content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image"       content={ogImage} />
  <meta name="twitter:image:alt"   content={ogImageAlt} />

  <!-- ═══════════════════════════════════════════
       THEME + MANIFEST
  ═══════════════════════════════════════════ -->
  <meta name="theme-color"  content={SITE.themeColor} />
  <meta name="color-scheme" content="dark" />
  <link rel="manifest"      href="/site.webmanifest" />

  <!-- ═══════════════════════════════════════════
       FAVICONS
  ═══════════════════════════════════════════ -->
  <link rel="icon"             type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" sizes="180x180"      href="/apple-touch-icon.png" />
  <link rel="icon"             type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="icon"             type="image/png" sizes="16x16" href="/favicon-16x16.png" />

  <!-- ═══════════════════════════════════════════
       PERFORMANCE: FONT LOADING
       <link> in HTML is always faster than @import in CSS.
       Preconnect first, then load the stylesheet.
  ═══════════════════════════════════════════ -->
  <link rel="preconnect"    href="https://fonts.googleapis.com" />
  <link rel="preconnect"    href="https://fonts.gstatic.com" crossorigin />
  <link rel="dns-prefetch"  href="https://fonts.googleapis.com" />
  <!-- Preload the most critical font subset for LCP (Space Grotesk 700 — used in H1) -->
  <link
    rel="preload"
    as="style"
    href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@600;700&display=swap"
    fetchpriority="high"
  />
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
    media="print"
    onload="this.media='all'"
  />
  <noscript>
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
    />
  </noscript>

  <!-- ═══════════════════════════════════════════
       STRUCTURED DATA — JSON-LD
       Organisation + WebSite on every page.
       Page-specific schemas are added via <slot name="schema">.
  ═══════════════════════════════════════════ -->
  <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
  <slot name="schema" />

  <!-- ═══════════════════════════════════════════
       MISC
  ═══════════════════════════════════════════ -->
  <!-- Prevent click-jacking -->
  <meta http-equiv="X-Frame-Options" content="SAMEORIGIN" />
  <!-- Referrer policy -->
  <meta name="referrer" content="strict-origin-when-cross-origin" />
</head>
<body>
  <slot />
</body>
</html>
