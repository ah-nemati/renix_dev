---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../config/seo';
---

<Layout
  title="404 — Page Not Found | Renix.dev"
  description="This page doesn't exist. Head back home or book a call."
  noindex={true}
  canonical={`${SITE.url}/404`}
>
  <Navbar />
  <main class="min-h-screen flex items-center justify-center relative overflow-hidden">
    <div class="absolute inset-0 bg-grid-pattern bg-grid opacity-40"></div>
    <div class="absolute inset-0 pointer-events-none"
         style="background: radial-gradient(ellipse 50% 50% at 50% 50%, rgba(79,124,255,0.07) 0%, transparent 70%);">
    </div>
    <div class="relative text-center px-6 py-32">
      <div
        class="font-display font-bold leading-none select-none mb-6 pointer-events-none"
        style="font-size: clamp(8rem, 22vw, 18rem); background: linear-gradient(135deg, rgba(79,124,255,0.18), rgba(168,85,247,0.18)); -webkit-background-clip: text; background-clip: text; color: transparent;"
        aria-hidden="true"
      >404</div>
      <div class="w-16 h-px bg-gradient-to-r from-transparent via-accent to-transparent mx-auto mb-8"></div>
      <h1 class="font-display font-bold text-2xl md:text-3xl text-ink mb-4">
        This page got lost<br class="hidden sm:block"/>
        <span class="text-ink-muted"> in deployment.</span>
      </h1>
      <p class="text-ink-muted text-sm max-w-xs mx-auto mb-10 leading-relaxed">
        It doesn't exist, was moved, or is still being built.<br/>
        We ship fast — but not <em>that</em> fast.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href="/" class="btn-primary">
          <span>Back to home</span>
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" class="relative z-10">
            <path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <a href="/#booking" class="btn-ghost">Book a call instead</a>
      </div>
      <div class="mt-16 inline-flex items-center gap-2 px-4 py-2 rounded-full"
           style="background: rgba(12,17,32,0.6); border: 1px solid rgba(30,45,69,0.8);">
        <span class="w-1.5 h-1.5 rounded-full bg-red-400/70 animate-pulse"></span>
        <span class="text-xs font-mono text-ink-faint">HTTP 404 — Route not found</span>
      </div>
    </div>
  </main>
  <Footer />
</Layout>
