---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import CaseStudies from '../components/CaseStudies.astro';
import Estimator from '../components/Estimator.astro';
import TechStack from '../components/TechStack.astro';
import Process from '../components/Process.astro';
import Testimonials from '../components/Testimonials.astro';
import FAQ from '../components/FAQ.astro';
import Newsletter from '../components/Newsletter.astro';
import Booking from '../components/Booking.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../config/seo';

// ── Page-level JSON-LD Schemas ────────────────────────────────────
const servicesSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Renix.dev Services',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      item: {
        '@type': 'Service',
        '@id': `${SITE.url}/#service-web`,
        name: 'Web Application Development',
        description: 'Full-stack web applications with Next.js, Astro, and Neon Serverless PostgreSQL.',
        provider: { '@id': `${SITE.url}/#organisation` },
        areaServed: 'Worldwide',
        url: `${SITE.url}/#services`,
        serviceType: 'Web Application Development',
      },
    },
    {
      '@type': 'ListItem',
      position: 2,
      item: {
        '@type': 'Service',
        '@id': `${SITE.url}/#service-ai`,
        name: 'AI & Automation Solutions',
        description: 'LLM integrations, RAG pipelines, custom AI agents with pgvector embeddings.',
        provider: { '@id': `${SITE.url}/#organisation` },
        areaServed: 'Worldwide',
        url: `${SITE.url}/#services`,
        serviceType: 'Artificial Intelligence Development',
      },
    },
    {
      '@type': 'ListItem',
      position: 3,
      item: {
        '@type': 'Service',
        '@id': `${SITE.url}/#service-mobile`,
        name: 'React Native Mobile Apps',
        description: 'Cross-platform native iOS and Android apps with 60 FPS performance and offline sync.',
        provider: { '@id': `${SITE.url}/#organisation` },
        areaServed: 'Worldwide',
        url: `${SITE.url}/#services`,
        serviceType: 'Mobile Application Development',
      },
    },
  ],
};

const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${SITE.url}/#webpage`,
  url: SITE.url,
  name: `${SITE.name} — ${SITE.tagline}`,
  description: SITE.description,
  isPartOf: { '@id': `${SITE.url}/#website` },
  about: { '@id': `${SITE.url}/#organisation` },
};
---

<Layout
  title="Renix.dev — High-Performance Software Development & AI Agency"
  description="We engineer full-stack SaaS platforms, custom AI/RAG copilot agents, and React Native mobile applications backed by Neon Serverless PostgreSQL."
  keywords={[
    'software development agency',
    'Neon postgres backend',
    'web app development',
    'AI development company',
    'React Native agency',
    'SaaS MVP development',
    'hire fullstack developers',
    'custom software agency',
    'Next.js development agency',
    'RAG pipeline engineering'
  ]}
>
  <script type="application/ld+json" slot="schema" set:html={JSON.stringify(servicesSchema)} />
  <script type="application/ld+json" slot="schema" set:html={JSON.stringify(webPageSchema)} />

  <Navbar />
  <main>
    <Hero />
    <Services />
    <CaseStudies />
    <Estimator />
    <TechStack />
    <Process />
    <Testimonials />
    <FAQ />
    <Newsletter />
    <Booking />
  </main>
  <Footer />

  <!-- Scroll reveal animations -->
  <script>
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
    );
    document.querySelectorAll('[data-reveal]').forEach(el => observer.observe(el));
  </script>

  <style is:global>
    [data-reveal] {
      opacity: 0;
      transform: translateY(24px);
      transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1), transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    }
    [data-reveal].is-visible { opacity: 1; transform: translateY(0); }
    [data-reveal-delay="1"] { transition-delay: 0.1s; }
    [data-reveal-delay="2"] { transition-delay: 0.2s; }
    [data-reveal-delay="3"] { transition-delay: 0.3s; }
    [data-reveal-delay="4"] { transition-delay: 0.4s; }
  </style>
</Layout>
