---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import Process from '../components/Process.astro';
import Testimonials from '../components/Testimonials.astro';
import FAQ from '../components/FAQ.astro';
import Booking from '../components/Booking.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../config/seo';
import { FAQ_ITEMS } from '../data/faq';

// ── Page-level JSON-LD ────────────────────────────────────────────

// Services schema (ItemList of Service offers)
const servicesSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Renix.dev Services',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      item: {
        '@type': 'Service',
        '@id': `${SITE.url}/#service-web`,
        name: 'Web Development',
        description: 'Full-stack web applications with modern frameworks. From SaaS dashboards to e-commerce platforms — we ship fast, then iterate faster.',
        provider: { '@id': `${SITE.url}/#organisation` },
        areaServed: 'Worldwide',
        url: `${SITE.url}/#services`,
        serviceType: 'Web Application Development',
      },
    },
    {
      '@type': 'ListItem',
      position: 2,
      item: {
        '@type': 'Service',
        '@id': `${SITE.url}/#service-ai`,
        name: 'AI & Automation',
        description: 'LLM integrations, RAG pipelines, custom AI agents, and computer vision — we build AI features that actually improve your product.',
        provider: { '@id': `${SITE.url}/#organisation` },
        areaServed: 'Worldwide',
        url: `${SITE.url}/#services`,
        serviceType: 'Artificial Intelligence Development',
      },
    },
    {
      '@type': 'ListItem',
      position: 3,
      item: {
        '@type': 'Service',
        '@id': `${SITE.url}/#service-mobile`,
        name: 'Mobile App Development',
        description: 'Cross-platform iOS and Android apps with React Native. Native performance, smooth UX, and a single team maintaining it all.',
        provider: { '@id': `${SITE.url}/#organisation` },
        areaServed: 'Worldwide',
        url: `${SITE.url}/#services`,
        serviceType: 'Mobile Application Development',
      },
    },
  ],
};

// WebPage schema for the homepage
const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${SITE.url}/#webpage`,
  url: SITE.url,
  name: `${SITE.name} — ${SITE.tagline}`,
  description: SITE.description,
  isPartOf: { '@id': `${SITE.url}/#website` },
  about: { '@id': `${SITE.url}/#organisation` },
  breadcrumb: {
    '@type': 'BreadcrumbList',
    itemListElement: [{
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: SITE.url,
    }],
  },
};
---

<Layout
  title="Renix.dev — Software Development Agency | Web, AI & Mobile"
  description="Renix.dev builds web apps, AI integrations, and React Native mobile apps for startups and scale-ups. Fixed-scope projects. On-time delivery. Full IP ownership."
  keywords={[
    'software development agency',
    'web app development',
    'AI development company',
    'React Native agency',
    'SaaS development',
    'MVP development agency',
    'hire software developers',
    'startup development agency',
    'custom software development',
    'Next.js development agency',
  ]}
>
  <!-- Page-level JSON-LD injected into Layout's <slot name="schema"> -->
  <script type="application/ld+json" slot="schema" set:html={JSON.stringify(servicesSchema)} />
  <script type="application/ld+json" slot="schema" set:html={JSON.stringify(webPageSchema)} />

  <Navbar />
  <main>
    <Hero />
    <Services />
    <Process />
    <Testimonials />
    <FAQ />
    <Booking />
  </main>
  <Footer />

  <!-- Scroll reveal -->
  <script>
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
    );
    document.querySelectorAll('[data-reveal]').forEach(el => observer.observe(el));
  </script>

  <style is:global>
    [data-reveal] {
      opacity: 0;
      transform: translateY(20px);
      transition: opacity 0.6s ease, transform 0.6s ease;
    }
    [data-reveal].is-visible { opacity: 1; transform: translateY(0); }
    [data-reveal-delay="1"] { transition-delay: 0.1s; }
    [data-reveal-delay="2"] { transition-delay: 0.2s; }
    [data-reveal-delay="3"] { transition-delay: 0.3s; }
    [data-reveal-delay="4"] { transition-delay: 0.4s; }
    [data-reveal-delay="5"] { transition-delay: 0.5s; }
    [data-reveal-delay="6"] { transition-delay: 0.6s; }
    [data-reveal-delay="7"] { transition-delay: 0.7s; }
  </style>
</Layout>
