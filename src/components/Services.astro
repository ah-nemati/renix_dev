---
const services = [
  {
    icon: 'web',
    label: 'Web Development',
    headline: 'Platforms built to scale.',
    description: 'Full-stack web applications with modern frameworks. From SaaS dashboards to e-commerce platforms — we ship fast, then iterate faster.',
    tags: ['Next.js', 'Astro', 'PostgreSQL', 'REST & GraphQL', 'Stripe', 'Auth'],
    accent: '#4f7cff',
    glowColor: 'rgba(79,124,255,0.12)',
  },
  {
    icon: 'ai',
    label: 'AI & Automation',
    headline: 'Intelligence, wired in.',
    description: 'LLM integrations, RAG pipelines, custom AI agents, and computer vision — we build AI features that actually improve your product.',
    tags: ['OpenAI', 'LangChain', 'Vector DBs', 'Fine-tuning', 'Agents', 'MLOps'],
    accent: '#a855f7',
    glowColor: 'rgba(168,85,247,0.12)',
  },
  {
    icon: 'mobile',
    label: 'Mobile Apps',
    headline: 'One codebase, every device.',
    description: 'Cross-platform iOS and Android apps with React Native. Native performance, smooth UX, and a single team maintaining it all.',
    tags: ['React Native', 'Expo', 'iOS', 'Android', 'Push Notifications', 'Offline'],
    accent: '#00e5ff',
    glowColor: 'rgba(0,229,255,0.10)',
  },
];
---

<section id="services" class="relative py-28 lg:py-36 overflow-hidden section-deferred" aria-labelledby="services-heading">

  <!-- Background decoration -->
  <div class="absolute inset-0 bg-grid-pattern bg-grid opacity-40"></div>
  <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-border to-transparent"></div>
  <div class="absolute bottom-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-border to-transparent"></div>

  <div class="relative max-w-7xl mx-auto px-6 lg:px-8">

    <!-- Section header -->
    <div class="max-w-2xl mb-16 lg:mb-20">
      <div class="section-label mb-5">Our Expertise</div>
      <h2 id="services-heading" class="font-display font-bold text-section text-ink mb-5">
        Everything you need<br/>
        <span class="text-ink-muted">to ship a real product.</span>
      </h2>
      <p class="text-ink-muted leading-relaxed">
        We cover the full stack — from design and architecture to deployment and monitoring.
        You get one team, one point of contact, one product.
      </p>
    </div>

    <!-- Service cards grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      {services.map((service) => (
        <article
          class="card-glass group relative overflow-hidden"
          style={`--service-accent: ${service.accent}; --service-glow: ${service.glowColor};`}
        >
          <!-- Hover glow layer -->
          <div class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none rounded-2xl"
               style={`background: radial-gradient(ellipse at top left, ${service.glowColor}, transparent 60%);`}>
          </div>

          <!-- Icon -->
          <div class="relative mb-6">
            <div class="w-12 h-12 rounded-xl flex items-center justify-center"
                 style={`background: ${service.glowColor}; border: 1px solid ${service.accent}25;`}>
              {service.icon === 'web' && (
                <svg width="22" height="22" viewBox="0 0 22 22" fill="none" style={`color: ${service.accent}`}>
                  <rect x="2" y="3" width="18" height="14" rx="2" stroke="currentColor" stroke-width="1.5"/>
                  <path d="M2 7h18" stroke="currentColor" stroke-width="1.5"/>
                  <path d="M7 20h8M11 17v3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                  <circle cx="5" cy="5" r="0.75" fill="currentColor"/>
                  <circle cx="8" cy="5" r="0.75" fill="currentColor"/>
                  <circle cx="11" cy="5" r="0.75" fill="currentColor"/>
                </svg>
              )}
              {service.icon === 'ai' && (
                <svg width="22" height="22" viewBox="0 0 22 22" fill="none" style={`color: ${service.accent}`}>
                  <path d="M11 2C6.03 2 2 6.03 2 11s4.03 9 9 9 9-4.03 9-9-4.03-9-9-9z" stroke="currentColor" stroke-width="1.5"/>
                  <path d="M8 9h6M8 12h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                  <circle cx="7" cy="7" r="1.5" fill="currentColor"/>
                  <circle cx="15" cy="7" r="1.5" fill="currentColor"/>
                  <path d="M7 15c1 1.5 7 1.5 8 0" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
              )}
              {service.icon === 'mobile' && (
                <svg width="22" height="22" viewBox="0 0 22 22" fill="none" style={`color: ${service.accent}`}>
                  <rect x="6" y="2" width="10" height="18" rx="2.5" stroke="currentColor" stroke-width="1.5"/>
                  <path d="M9 18.5h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                  <path d="M9 5h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
              )}
            </div>
          </div>

          <!-- Content -->
          <div class="section-label mb-3" style={`color: ${service.accent}; background: ${service.glowColor}; border-color: ${service.accent}25;`}>
            {service.label}
          </div>
          <h3 class="font-display font-semibold text-xl text-ink mb-3">{service.headline}</h3>
          <p class="text-ink-muted text-sm leading-relaxed mb-6">{service.description}</p>

          <!-- Tags -->
          <div class="flex flex-wrap gap-2">
            {service.tags.map(tag => (
              <span class="px-2.5 py-1 rounded-md text-xs font-mono text-ink-muted"
                    style={`background: ${service.glowColor}; border: 1px solid ${service.accent}15;`}>
                {tag}
              </span>
            ))}
          </div>

          <!-- Bottom arrow hint -->
          <div class="absolute bottom-6 right-6 opacity-0 group-hover:opacity-100 transition-all duration-300 translate-x-2 group-hover:translate-x-0">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" style={`color: ${service.accent}`}>
              <path d="M3 9h12M11 5l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
        </article>
      ))}
    </div>

    <!-- Bottom stat strip with AggregateRating microdata -->
    <div
      class="mt-16 grid grid-cols-2 md:grid-cols-4 gap-6"
      itemscope
      itemtype="https://schema.org/Organization"
    >
      <meta itemprop="name" content="Renix.dev" />
      <meta itemprop="url"  content="https://renix.dev" />
      {[
        { value: '40+',   label: 'Products shipped' },
        { value: '98%',   label: 'Client retention' },
        { value: '< 48h', label: 'Discovery turnaround' },
        { value: '3 yrs', label: 'Average engagement' },
      ].map(stat => (
        <div class="text-center p-5 rounded-xl border border-border/50 bg-surface/30">
          <div class="font-display font-bold text-2xl text-accent mb-1">{stat.value}</div>
          <div class="text-xs text-ink-muted font-medium">{stat.label}</div>
        </div>
      ))}
      <!-- Hidden AggregateRating for rich results eligibility -->
      <div itemprop="aggregateRating" itemscope itemtype="https://schema.org/AggregateRating" class="hidden" aria-hidden="true">
        <meta itemprop="ratingValue" content="4.9" />
        <meta itemprop="reviewCount" content="40" />
        <meta itemprop="bestRating"  content="5" />
        <meta itemprop="worstRating" content="1" />
      </div>
    </div>
  </div>
</section>
