---
import CaseStudiesComponent from './CaseStudies';
---

<section
  id="work"
  class="relative py-28 lg:py-36 overflow-hidden section-deferred"
  aria-labelledby="work-heading"
>
  <div class="absolute inset-0 bg-grid-pattern bg-grid opacity-30 pointer-events-none"></div>
  <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-[#1e2d45] to-transparent"></div>

  <div class="relative max-w-7xl mx-auto px-6 lg:px-8">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6">
      <div class="max-w-2xl">
        <div class="section-label mb-4">Selected Case Studies</div>
        <h2
          id="work-heading"
          class="font-display font-bold text-section text-ink mb-5 leading-tight"
        >
          Proven systems built<br />
          <span class="text-ink-muted">for founders and scale-ups.</span>
        </h2>
        <p class="text-ink-muted text-base leading-relaxed">
          Explore how we helped our clients engineer mission-critical platforms with modern architectures.
        </p>
      </div>

      <div class="hidden md:block text-right">
        <span class="text-xs font-mono text-[#6b7a99] block">Average Client ROI</span>
        <span class="font-display font-bold text-3xl text-[#4ade80]">3.8x in 6 Months</span>
      </div>
    </div>

    <!-- Interactive Component -->
    <CaseStudiesComponent client:load />
  </div>
</section>
