---
const stackCategories = [
  {
    category: "Frontend & Mobile",
    description: "Ultra-fast, accessible interfaces built for 60fps smoothness and SEO supremacy.",
    techs: [
      { name: "Next.js 15", role: "App Router & React Server Components", tag: "Web" },
      { name: "Astro", role: "Content & High-Performance Static/SSR Sites", tag: "Web" },
      { name: "React Native & Expo", role: "Cross-platform native iOS & Android apps", tag: "Mobile" },
      { name: "Tailwind CSS", role: "Modular, responsive design system design tokens", tag: "Styling" },
    ],
    accent: "#4f7cff",
  },
  {
    category: "Databases & Storage",
    description: "Serverless, distributed, and vector-enabled storage for maximum reliability.",
    techs: [
      { name: "Neon PostgreSQL", role: "Serverless Postgres with autoscaling & branching", tag: "Database" },
      { name: "pgvector", role: "High-dimensional vector embeddings for AI RAG", tag: "AI Search" },
      { name: "Redis / Upstash", role: "Low-latency caching & distributed rate-limiting", tag: "Cache" },
      { name: "Cloudflare R2 / S3", role: "Edge-distributed object & media storage", tag: "Storage" },
    ],
    accent: "#00e5ff",
  },
  {
    category: "AI & LLM Orchestration",
    description: "Production-ready AI agents, retrieval pipelines, and fine-tuned models.",
    techs: [
      { name: "LangChain & LangGraph", role: "Multi-agent coordination & state machines", tag: "Agents" },
      { name: "OpenAI & Anthropic", role: "GPT-4o, Claude 3.5 Sonnet frontier models", tag: "LLMs" },
      { name: "Ollama / vLLM", role: "Self-hosted private models for high compliance", tag: "Local AI" },
      { name: "Unstructured / PyPDF", role: "High-fidelity enterprise document parsers", tag: "Data" },
    ],
    accent: "#a855f7",
  },
  {
    category: "Cloud, APIs & Payments",
    description: "Zero-maintenance edge infrastructure with enterprise-grade security.",
    techs: [
      { name: "Vercel & AWS", role: "Global edge CDN & serverless compute", tag: "Infra" },
      { name: "Stripe Connect", role: "Global subscriptions, invoices & marketplace payouts", tag: "Payments" },
      { name: "Clerk / NextAuth", role: "SOC2-ready authentication, SSO & passkeys", tag: "Auth" },
      { name: "Docker & GitHub Actions", role: "Automated CI/CD pipelines & container orchestration", tag: "DevOps" },
    ],
    accent: "#4ade80",
  },
];
---

<section id="tech-stack" class="relative py-28 lg:py-36 overflow-hidden section-deferred" aria-labelledby="tech-stack-heading">
  <div class="absolute inset-0 bg-grid-pattern bg-grid opacity-30 pointer-events-none"></div>
  <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-[#1e2d45] to-transparent"></div>

  <div class="relative max-w-7xl mx-auto px-6 lg:px-8">
    <!-- Header -->
    <div class="max-w-2xl mb-16">
      <div class="section-label mb-4">Battle-Tested Architecture</div>
      <h2 id="tech-stack-heading" class="font-display font-bold text-section text-ink mb-5 leading-tight">
        Modern Stack.<br />
        <span class="text-ink-muted">Zero Legacy Debt.</span>
      </h2>
      <p class="text-ink-muted text-base leading-relaxed">
        We don&apos;t experiment on your dime. We build on the most performant, battle-tested modern tools available today.
      </p>
    </div>

    <!-- 4-Box Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
      {stackCategories.map((cat) => (
        <div class="rounded-3xl border border-[#1e2d45] bg-[#0c1120]/80 p-7 lg:p-8 backdrop-blur-xl transition-all duration-300 hover:border-[#4f7cff]/40 hover:bg-[#0f172a]">
          <div class="flex items-center gap-3 mb-3">
            <span class="w-3 h-3 rounded-full" style={`background-color: ${cat.accent}; box-shadow: 0 0 10px ${cat.accent};`}></span>
            <h3 class="font-display font-bold text-lg text-[#e8edf7]">{cat.category}</h3>
          </div>
          <p class="text-xs text-[#6b7a99] mb-6 leading-relaxed">{cat.description}</p>

          <div class="space-y-3">
            {cat.techs.map((tech) => (
              <div class="p-3.5 rounded-xl bg-[#070b14]/80 border border-[#1e2d45]/70 flex items-center justify-between hover:border-[#4f7cff]/30 transition-colors">
                <div>
                  <div class="font-display font-semibold text-sm text-[#e8edf7] flex items-center gap-2">
                    <span>{tech.name}</span>
                  </div>
                  <div class="text-xs text-[#6b7a99] mt-0.5">{tech.role}</div>
                </div>
                <span class="text-[10px] font-mono px-2.5 py-1 rounded-md bg-[#111827] text-[#7fa0ff] border border-[#1e2d45]">
                  {tech.tag}
                </span>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
