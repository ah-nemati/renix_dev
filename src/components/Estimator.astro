---
import EstimatorComponent from './Estimator';
---

<section
  id="estimator"
  class="relative py-28 lg:py-36 overflow-hidden section-deferred"
  aria-labelledby="estimator-heading"
>
  <!-- Ambient background glow -->
  <div class="absolute inset-0 bg-grid-pattern bg-grid opacity-30 pointer-events-none"></div>
  <div
    class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[700px] opacity-10 blur-[140px] pointer-events-none"
    style="background: radial-gradient(circle, #00e5ff 0%, #4f7cff 50%, transparent 75%);"
    aria-hidden="true"
  ></div>
  <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-[#4f7cff]/30 to-transparent"></div>

  <div class="relative max-w-7xl mx-auto px-6 lg:px-8">
    <!-- Header -->
    <div class="max-w-3xl mb-16">
      <div class="section-label mb-4">Interactive Cost Calculator</div>
      <h2
        id="estimator-heading"
        class="font-display font-bold text-section text-ink mb-5 leading-tight"
      >
        Scope & Price Your Build<br />
        <span class="text-ink-muted">transparently before we talk.</span>
      </h2>
      <p class="text-ink-muted text-base leading-relaxed">
        Select your project parameters below to get an instant, data-backed estimate of timeline, architecture, and investment.
      </p>
    </div>

    <!-- Interactive React Component -->
    <EstimatorComponent client:load />
  </div>
</section>
