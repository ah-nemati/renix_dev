---
import CommandPalette from './CommandPalette';
---

<nav id="navbar" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 bg-void/80 backdrop-blur-xl border-b border-border/40" aria-label="Main navigation">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2.5 group" aria-label="Renix.dev home">
        <div class="relative w-8 h-8">
          <div class="absolute inset-0 rounded-lg bg-accent opacity-25 group-hover:opacity-60 transition-opacity duration-300 blur-sm"></div>
          <div class="relative w-8 h-8 rounded-lg border border-accent/40 flex items-center justify-center bg-surface shadow-[0_0_12px_rgba(79,124,255,0.25)]">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M2 2L7 8L2 14H5L8 10.5L11 14H14L9 8L14 2H11L8 5.5L5 2H2Z" fill="#4f7cff"/>
            </svg>
          </div>
        </div>
        <span class="font-display font-bold text-lg text-ink tracking-tight">
          renix<span class="text-accent">.dev</span>
        </span>
      </a>

      <!-- Desktop Navigation Links -->
      <div class="hidden lg:flex items-center gap-7">
        <a href="/#services" class="nav-link text-xs font-mono text-ink-muted hover:text-ink transition-colors duration-200" data-section="services">Services</a>
        <a href="/#work"     class="nav-link text-xs font-mono text-ink-muted hover:text-ink transition-colors duration-200" data-section="work">Case Studies</a>
        <a href="/#estimator" class="nav-link text-xs font-mono text-[#00e5ff] hover:text-white transition-colors duration-200 flex items-center gap-1" data-section="estimator">
          <span>Estimator</span>
          <span class="w-1.5 h-1.5 rounded-full bg-[#00e5ff] animate-pulse"></span>
        </a>
        <a href="/#tech-stack" class="nav-link text-xs font-mono text-ink-muted hover:text-ink transition-colors duration-200" data-section="tech-stack">Stack</a>
        <a href="/#process"  class="nav-link text-xs font-mono text-ink-muted hover:text-ink transition-colors duration-200" data-section="process">Process</a>
        <a href="/#faq"      class="nav-link text-xs font-mono text-ink-muted hover:text-ink transition-colors duration-200" data-section="faq">FAQ</a>
      </div>

      <!-- Right Action Items (Cmd+K, Admin, CTA) -->
      <div class="flex items-center gap-3">
        <!-- Command Palette Trigger -->
        <CommandPalette client:load />

        <!-- Admin quick link -->
        <a 
          href="/admin" 
          class="hidden sm:inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-mono text-ink-muted hover:text-ink hover:bg-surface border border-transparent hover:border-border transition-all"
          title="Admin & Neon DB Dashboard"
        >
          <span class="w-1.5 h-1.5 rounded-full bg-[#4ade80]"></span>
          <span>Admin</span>
        </a>

        <!-- Primary CTA -->
        <a href="/#booking" class="btn-primary py-2 px-4 text-xs">
          <span>Book a Call</span>
          <svg width="12" height="12" viewBox="0 0 14 14" fill="none" class="relative z-10">
            <path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>

        <!-- Mobile menu toggle button -->
        <button id="mobile-menu-btn" class="lg:hidden p-2 rounded-lg text-ink-muted hover:text-ink hover:bg-panel transition-all" aria-label="Toggle menu" aria-expanded="false">
          <svg id="icon-open" width="20" height="20" viewBox="0 0 20 20" fill="none">
            <path d="M3 5h14M3 10h14M3 15h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
          <svg id="icon-close" class="hidden" width="20" height="20" viewBox="0 0 20 20" fill="none">
            <path d="M5 5l10 10M15 5L5 15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Menu Dropdown -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-border bg-surface/98 backdrop-blur-2xl">
    <div class="px-6 py-4 flex flex-col gap-1 text-sm font-mono">
      <a href="/#services" class="mobile-nav-link py-2.5 border-b border-border/30 text-ink-muted hover:text-ink">Services</a>
      <a href="/#work"     class="mobile-nav-link py-2.5 border-b border-border/30 text-ink-muted hover:text-ink">Case Studies</a>
      <a href="/#estimator" class="mobile-nav-link py-2.5 border-b border-border/30 text-[#00e5ff] hover:text-white">Estimator (Live Pricing)</a>
      <a href="/#tech-stack" class="mobile-nav-link py-2.5 border-b border-border/30 text-ink-muted hover:text-ink">Tech Stack & Neon DB</a>
      <a href="/#process"  class="mobile-nav-link py-2.5 border-b border-border/30 text-ink-muted hover:text-ink">Process</a>
      <a href="/#faq"      class="mobile-nav-link py-2.5 border-b border-border/30 text-ink-muted hover:text-ink">FAQ</a>
      <a href="/admin"     class="mobile-nav-link py-2.5 border-b border-border/30 text-[#4ade80] hover:text-white flex items-center justify-between">
        <span>Admin & DB Dashboard</span>
        <span class="text-[10px] px-2 py-0.5 rounded bg-[#4ade80]/15 text-[#4ade80]">Neon DB</span>
      </a>
      <a href="/#booking"  class="mobile-nav-link py-2.5 text-accent font-semibold">Book a Strategy Call →</a>
    </div>
  </div>
</nav>

<script>
  const navbar     = document.getElementById('navbar');
  const mobileBtn  = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const iconOpen   = document.getElementById('icon-open');
  const iconClose  = document.getElementById('icon-close');

  window.addEventListener('scroll', () => {
    if (window.scrollY > 20) {
      navbar?.classList.add('bg-void/95', 'backdrop-blur-2xl', 'border-border/70', 'shadow-[0_10px_30px_rgba(0,0,0,0.5)]');
    } else {
      navbar?.classList.remove('shadow-[0_10px_30px_rgba(0,0,0,0.5)]');
    }
  }, { passive: true });

  function closeMobileMenu() {
    mobileMenu?.classList.add('hidden');
    iconOpen?.classList.remove('hidden');
    iconClose?.classList.add('hidden');
    mobileBtn?.setAttribute('aria-expanded', 'false');
  }

  mobileBtn?.addEventListener('click', () => {
    const isOpen = !mobileMenu?.classList.contains('hidden');
    if (isOpen) {
      closeMobileMenu();
    } else {
      mobileMenu?.classList.remove('hidden');
      iconOpen?.classList.add('hidden');
      iconClose?.classList.remove('hidden');
      mobileBtn?.setAttribute('aria-expanded', 'true');
    }
  });

  document.querySelectorAll('.mobile-nav-link').forEach(link =>
    link.addEventListener('click', closeMobileMenu)
  );
</script>
