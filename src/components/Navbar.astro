---
---

<nav id="navbar" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300" aria-label="Main navigation">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2.5 group" aria-label="Renix.dev home">
        <div class="relative w-8 h-8">
          <div class="absolute inset-0 rounded-lg bg-accent opacity-20 group-hover:opacity-40 transition-opacity duration-300 blur-sm"></div>
          <div class="relative w-8 h-8 rounded-lg border border-accent/40 flex items-center justify-center bg-surface">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M2 2L7 8L2 14H5L8 10.5L11 14H14L9 8L14 2H11L8 5.5L5 2H2Z" fill="#4f7cff"/>
            </svg>
          </div>
        </div>
        <span class="font-display font-semibold text-lg text-ink tracking-tight">
          renix<span class="text-accent">.dev</span>
        </span>
      </a>

      <!-- Desktop Links -->
      <div class="hidden md:flex items-center gap-8">
        <a href="#services" class="text-sm text-ink-muted hover:text-ink transition-colors duration-200 font-medium">Services</a>
        <a href="#process" class="text-sm text-ink-muted hover:text-ink transition-colors duration-200 font-medium">Process</a>
        <a href="#booking" class="text-sm text-ink-muted hover:text-ink transition-colors duration-200 font-medium">Contact</a>
      </div>

      <!-- CTA -->
      <div class="flex items-center gap-3">
        <a href="#booking" class="btn-primary">
          <span>Book a Call</span>
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" class="relative z-10">
            <path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>

        <!-- Mobile menu button -->
        <button id="mobile-menu-btn" class="md:hidden p-2 rounded-lg text-ink-muted hover:text-ink hover:bg-panel transition-all" aria-label="Toggle menu">
          <svg id="menu-icon" width="20" height="20" viewBox="0 0 20 20" fill="none">
            <path d="M3 5h14M3 10h14M3 15h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-border bg-surface/95 backdrop-blur-xl">
    <div class="px-6 py-4 flex flex-col gap-4">
      <a href="#services" class="text-sm text-ink-muted hover:text-ink transition-colors py-1">Services</a>
      <a href="#process" class="text-sm text-ink-muted hover:text-ink transition-colors py-1">Process</a>
      <a href="#booking" class="text-sm text-ink-muted hover:text-ink transition-colors py-1">Contact</a>
    </div>
  </div>
</nav>

<script>
  // Navbar scroll behavior
  const navbar = document.getElementById('navbar');
  const mobileBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');

  window.addEventListener('scroll', () => {
    if (window.scrollY > 20) {
      navbar?.classList.add('bg-void/90', 'backdrop-blur-xl', 'border-b', 'border-border/50');
    } else {
      navbar?.classList.remove('bg-void/90', 'backdrop-blur-xl', 'border-b', 'border-border/50');
    }
  });

  mobileBtn?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });

  // Close mobile menu on link click
  mobileMenu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => mobileMenu.classList.add('hidden'));
  });
</script>
