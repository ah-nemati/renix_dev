---
import HeroCanvas from './HeroCanvas';
import InteractiveTerminal from './InteractiveTerminal';
---

<section
  class="relative min-h-[92vh] flex items-center overflow-hidden pt-20 pb-16"
  aria-labelledby="hero-heading"
>
  <!-- Interactive Particle Background Canvas -->
  <HeroCanvas client:load />

  <!-- Background grid & ambient gradients -->
  <div class="absolute inset-0 bg-grid-pattern bg-grid opacity-60 pointer-events-none"></div>
  <div class="absolute inset-0 bg-hero-gradient pointer-events-none"></div>

  <!-- Ambient Glow Orbs -->
  <div
    class="absolute top-1/4 left-1/6 w-[500px] h-[500px] rounded-full opacity-20 blur-[120px] pointer-events-none"
    style="background: radial-gradient(circle, #4f7cff 0%, #a855f7 50%, transparent 70%);"
    aria-hidden="true"
  ></div>
  <div
    class="absolute bottom-1/4 right-1/6 w-[450px] h-[450px] rounded-full opacity-15 blur-[100px] pointer-events-none"
    style="background: radial-gradient(circle, #00e5ff 0%, #4f7cff 60%, transparent 75%);"
    aria-hidden="true"
  ></div>

  <div class="relative w-full max-w-7xl mx-auto px-6 lg:px-8 py-12 lg:py-20 z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      <!-- LEFT COLUMN: Value Proposition & CTAs (7 cols on lg) -->
      <div class="lg:col-span-7">
        
        <!-- Live status badge -->
        <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full text-xs font-mono mb-8 border border-[#4f7cff]/30 bg-[#4f7cff]/10 backdrop-blur-md">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#00e5ff] opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-[#00e5ff]"></span>
          </span>
          <span class="text-[#7fa0ff] font-medium tracking-wide">Q3 2026 Cohort: Open for 2 New Projects</span>
        </div>

        <!-- H1 Headline -->
        <h1
          id="hero-heading"
          class="font-display font-extrabold text-hero text-ink mb-6 tracking-tight leading-[1.04]"
        >
          We build
          <span class="relative inline-block mx-1">
            <span
              class="relative z-10 text-transparent bg-clip-text"
              style="background-image: linear-gradient(135deg, #4f7cff 0%, #a855f7 40%, #00e5ff 100%);"
            >
              world-class
            </span>
          </span>
          <br class="hidden sm:inline" />
          software that converts.
        </h1>

        <!-- Subhead -->
        <p class="font-body text-lg lg:text-xl text-[#94a3b8] max-w-2xl mb-10 leading-relaxed">
          From high-scale Web Platforms & AI Copilots to React Native mobile apps.
          We architect, code, and deploy production systems backed by modern databases like Neon PostgreSQL.
        </p>

        <!-- CTA Buttons Row -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4">
          <a
            href="#booking"
            class="relative inline-flex items-center justify-center gap-2.5 px-8 py-4 rounded-xl font-display font-semibold text-base text-white overflow-hidden transition-all duration-300 group hover:shadow-[0_0_35px_rgba(79,124,255,0.45)] hover:-translate-y-0.5"
            style="background: linear-gradient(135deg, #4f7cff, #6b5ce7); border: 1px solid rgba(79,124,255,0.5);"
          >
            <span>Book a Free Strategy Call</span>
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" class="transition-transform duration-200 group-hover:translate-x-1">
              <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>

          <a
            href="#estimator"
            class="inline-flex items-center justify-center gap-2 px-6 py-4 rounded-xl font-display font-medium text-base text-[#94a3b8] border border-[#1e2d45] bg-[#0c1120]/80 hover:text-white hover:border-[#4f7cff]/50 hover:bg-[#111827] transition-all"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="text-[#00e5ff]">
              <rect width="16" height="20" x="4" y="2" rx="2"/>
              <line x1="8" x2="16" y1="6" y2="6"/>
              <line x1="16" x2="16" y1="14" y2="18"/>
              <path d="M16 10h.01"/>
              <path d="M12 10h.01"/>
              <path d="M8 10h.01"/>
              <path d="M12 14h.01"/>
              <path d="M8 14h.01"/>
              <path d="M12 18h.01"/>
              <path d="M8 18h.01"/>
            </svg>
            <span>Calculate Project Scope</span>
          </a>
        </div>

        <!-- Social Proof Stats Strip -->
        <div class="mt-12 pt-8 border-t border-[#1e2d45]/70 grid grid-cols-2 sm:grid-cols-4 gap-6">
          <div>
            <div class="font-display font-bold text-2xl lg:text-3xl text-white tracking-tight">40+</div>
            <div class="text-xs font-mono text-[#6b7a99] mt-0.5">Products Shipped</div>
          </div>
          <div>
            <div class="font-display font-bold text-2xl lg:text-3xl text-[#00e5ff] tracking-tight">2 Weeks</div>
            <div class="text-xs font-mono text-[#6b7a99] mt-0.5">Average MVP Delivery</div>
          </div>
          <div>
            <div class="font-display font-bold text-2xl lg:text-3xl text-[#a855f7] tracking-tight">99.99%</div>
            <div class="text-xs font-mono text-[#6b7a99] mt-0.5">System Reliability</div>
          </div>
          <div>
            <div class="font-display font-bold text-2xl lg:text-3xl text-[#4ade80] tracking-tight">4.9 / 5.0</div>
            <div class="text-xs font-mono text-[#6b7a99] mt-0.5">Client Satisfaction</div>
          </div>
        </div>

      </div>

      <!-- RIGHT COLUMN: Interactive Terminal & Code Sandbox (5 cols on lg) -->
      <div class="lg:col-span-5 flex justify-center lg:justify-end">
        <InteractiveTerminal client:load />
      </div>

    </div>
  </div>
</section>
