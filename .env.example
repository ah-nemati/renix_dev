# ─── Renix.dev Environment Variables ───────────────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Site URL
PUBLIC_SITE_URL=http://localhost:4321

# Neon Serverless PostgreSQL Database Connection
# Format: postgresql://[user]:[password]@[neon_hostname]/[dbname]?sslmode=require
DATABASE_URL=

# Admin Dashboard Passcode (Default is renix2026)
ADMIN_PASSCODE=renix2026

# Email Notifications (optional e.g. Resend)
# RESEND_API_KEY=re_xxxxxxxxxxxx
# NOTIFICATION_EMAIL=hello@renix.dev
