# ─── Renix.dev Environment Variables ───────────────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Site
PUBLIC_SITE_URL=https://renix.dev

# Email (e.g. Resend)
# RESEND_API_KEY=re_xxxxxxxxxxxx
# NOTIFICATION_EMAIL=hello@renix.dev

# Database (e.g. PlanetScale / Neon / Supabase)
# DATABASE_URL=

# CRM (optional, e.g. HubSpot)
# HUBSPOT_API_KEY=
